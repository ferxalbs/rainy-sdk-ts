{
  "name": "rainy-sdk-ts",
  "version": "0.4.1",
  "description": "Telemetry and internal-logic instrumentation for AI products — privacy-safe observation without replacing provider SDKs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench",
    "pack:check": "node scripts/check-package.mjs",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build && bun run pack:check"
  },
  "keywords": [
    "rainy",
    "sdk",
    "telemetry",
    "observability",
    "instrumentation",
    "agents",
    "llm",
    "privacy",
    "tracing",
    "ai",
    "activators",
    "counters",
    "hooks"
  ],
  "author": "ferxalbs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferxalbs/rainy-sdk-ts.git"
  },
  "homepage": "https://github.com/ferxalbs/rainy-sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/ferxalbs/rainy-sdk-ts/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "mitt": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
